#include <dt-bindings/zmk/matrix-transform.h>

{
    chosen{
        zmk,kscan = &default_kscan;
        zmk,matrix_transform = &default_transform;
    };

    default_kscan: kscan{
        compatible = "zmk,kscan_gpio_matrix";
        label = "default_kscan";
        diode_direction = "col2row";

        row-gpios = <&pro_micro 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <>,
                    <>,
                    <>;

        col-gpios = <&pro_micro 5 GPIO_ACTIVE_HIGH>,
                    <>,
                    <>,
                    <>,
                    <>;
    };

    default_transform: matrix_transform{
        compatible = "zmk,matrix_transform";
        rows = <4>;
        columns = <5>;

        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) 
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)
                            RC(3,2) RC(3,3) RC(3,4)
        >;
    };
}